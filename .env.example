# AWS region hosting Bedrock, DynamoDB, and S3
AWS_REGION=us-east-1

# Bedrock model id for Amazon Nova Lite (check availability in your region/account)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# DynamoDB table for complaint records (created automatically if missing, see setup_aws.py)
DYNAMODB_TABLE=civicmate-complaints

# S3 bucket for photo evidence (must be globally unique; created automatically if missing)
S3_BUCKET=civicmate-evidence-CHANGE-ME

# Set to "1" to force the deterministic demo engine even if Bedrock is reachable
FORCE_DEMO_ENGINE=0

# Session token signing secret — generate with: openssl rand -hex 32
CIVICMATE_SESSION_SECRET=

# DynamoDB table for single-use magic-link tokens (created by setup_aws.py, TTL enabled)
MAGIC_LINKS_TABLE=civicmate-magic-links

# Verified SES sender address for magic-link emails. Leave blank to fall back to
# logging the link server-side instead of emailing it (see app/email_sender.py).
SES_SENDER_EMAIL=

# Public base URL this app is reachable at, used to build the emailed sign-in link
APP_BASE_URL=http://localhost:8000
