{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "ProvisionComplaintsTable",
      "Effect": "Allow",
      "Action": ["dynamodb:CreateTable", "dynamodb:DescribeTable"],
      "Resource": "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/civicmate-complaints"
    },
    {
      "Sid": "ProvisionEvidenceBucket",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:HeadBucket", "s3:GetBucketLocation", "s3:PutBucketPublicAccessBlock"],
      "Resource": "arn:aws:s3:::<YOUR_BUCKET_NAME>"
    },
    {
      "Sid": "ECRRepoManagement",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:<REGION>:<ACCOUNT_ID>:repository/civicmate",
        "arn:aws:ecr:<REGION>:<ACCOUNT_ID>:repository/civicmate-agent"
      ]
    },
    {
      "Sid": "ECRLogin",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "IAMRoleManagement",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:PutRolePolicy", "iam:AttachRolePolicy"],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/AppRunnerECRAccessRole",
        "arn:aws:iam::<ACCOUNT_ID>:role/CivicMateAppRunnerInstanceRole",
        "arn:aws:iam::<ACCOUNT_ID>:role/CivicMateAgentCoreExecutionRole"
      ]
    },
    {
      "Sid": "PassRolesToServices",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/AppRunnerECRAccessRole",
        "arn:aws:iam::<ACCOUNT_ID>:role/CivicMateAppRunnerInstanceRole",
        "arn:aws:iam::<ACCOUNT_ID>:role/CivicMateAgentCoreExecutionRole"
      ]
    },
    {
      "Sid": "AppRunnerDeploy",
      "Effect": "Allow",
      "Action": ["apprunner:CreateService", "apprunner:DescribeService", "apprunner:UpdateService", "apprunner:ListServices"],
      "Resource": "*"
    },
    {
      "Sid": "AgentCoreDeploy",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore-control:CreateAgentRuntime",
        "bedrock-agentcore-control:GetAgentRuntime",
        "bedrock-agentcore-control:UpdateAgentRuntime",
        "bedrock-agentcore-control:ListAgentRuntimes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockTesting",
      "Effect": "Allow",
      "Action": ["bedrock:ListFoundationModels", "bedrock:GetFoundationModel", "bedrock:InvokeModel"],
      "Resource": "*"
    },
    {
      "Sid": "QuotaRequests",
      "Effect": "Allow",
      "Action": [
        "servicequotas:GetServiceQuota",
        "servicequotas:ListServiceQuotas",
        "servicequotas:RequestServiceQuotaIncrease",
        "servicequotas:GetRequestedServiceQuotaChange"
      ],
      "Resource": "*"
    }
  ]
}
